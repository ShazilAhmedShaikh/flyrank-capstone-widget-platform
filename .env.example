# ==============================================================================
# FlyRank Capstone: Embeddable Widget Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed.
# NEVER commit the actual .env file to version control.

# Application Settings
APP_NAME="FlyRank Embeddable Widget Platform"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
JWT_SECRET_KEY="super-secret-dev-jwt-key-replace-in-production-min-32-chars-long"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for $0 zero-dependency local runs)
DATABASE_URL="sqlite+aiosqlite:///./widget_platform.db"

# Payload & Boundary Limits
MAX_PAYLOAD_SIZE_BYTES=65536

# Rate Limiting Settings
RATE_LIMIT_PER_MINUTE_IP=30
RATE_LIMIT_PER_MINUTE_WIDGET=60
RATE_LIMIT_BURST_MAX=5
RATE_LIMIT_BURST_WINDOW_SECONDS=10

# Geolocation Enrichment Providers (HTTP Fallback Chain)
GEO_PROVIDER_A_URL="http://ip-api.com/json/{ip}"
GEO_PROVIDER_B_URL="https://ipapi.co/{ip}/json/"
GEO_TIMEOUT_SECONDS=2.5

# Simulation / Mock Toggles for Automated Probes & Fallback Testing
SIMULATE_GEO_PROVIDER_A_DOWN=false
SIMULATE_GEO_PROVIDER_B_DOWN=false
SIMULATE_SIDE_EFFECT_FAILURE=false

# Secondary Side Effect (Email / Webhook Notification)
NOTIFICATION_CHANNEL="log"
ALERT_WEBHOOK_URL="http://localhost:9999/webhook-mock"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL="noreply@widgets.flyrank.local"
